# Application Configuration
APP_NAME="AI Medical Assistant"
APP_ENV="development"
DEBUG=True
PORT=8000

# Security Encryption Key (Fernet 32 url-safe base64-encoded bytes key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="change_me_to_a_valid_fernet_key_32_bytes_base64"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aimed_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aimed_db

# Redis Configuration (Debounce Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/v1/webhook/telegram"
